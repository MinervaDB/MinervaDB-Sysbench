# =============================================================================
# MinervaDB-Sysbench Enterprise — Development Profile
# =============================================================================
# Use this profile for local development and CI quick-smoke tests.
# Low thread counts and table sizes for fast iteration.
#
# To use:
#   export DB_PASSWORD=your_dev_password
#   ./enterprise/scripts/run_benchmark.sh --profile dev --workload oltp_read_write
# =============================================================================

# === Database Connection ===
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sbtest
DB_USER=sbtest
DB_SSL=off

# === Workload Parameters (lightweight for dev) ===
SB_THREADS=4
SB_TIME=30
SB_REPORT_INTERVAL=5
SB_TABLES=4
SB_TABLE_SIZE=10000
SB_PERCENTILE=95
SB_WARMUP_TIME=5
SB_RAND_TYPE=uniform

# === SLO Thresholds (disabled for dev — use staging/prod for enforcement) ===
SLO_MIN_TPS=0
SLO_MAX_P95_LATENCY_MS=0
SLO_MAX_P99_LATENCY_MS=0
SLO_MAX_ERROR_RATE_PCT=0

# === Output ===
RESULTS_DIR=./enterprise/results
OUTPUT_FORMAT=json
KEEP_RAW_LOG=true

# === Integrations (all disabled for dev) ===
PROMETHEUS_PUSHGATEWAY=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
