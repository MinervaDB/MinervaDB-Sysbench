# =============================================================================
# MinervaDB-Sysbench Enterprise — Configuration Profile Template
# =============================================================================
# Copy this file to create environment-specific profiles:
#   cp profile.template.env dev.env
#   cp profile.template.env staging.env
#   cp profile.template.env production.env
#
# SECURITY: Never commit files containing real passwords.
# Use .local.env files (git-excluded) for secrets, or inject via environment.
#
# Usage with run_benchmark.sh:
#   ./enterprise/scripts/run_benchmark.sh --profile <profile_name>
#   (loads enterprise/config/<profile_name>.env)
# =============================================================================

# =============================================================================
# DATABASE CONNECTION
# =============================================================================

# Database type: mysql | mariadb | pgsql | postgresql
DB_TYPE=mysql

# Database host — use FQDN or IP address
# Examples: db-primary.prod.internal | 10.0.1.50 | localhost
DB_HOST=localhost

# Database port (MySQL default: 3306, PostgreSQL default: 5432)
DB_PORT=3306

# Target database/schema name
DB_NAME=sbtest

# Database user with sysbench privileges (see Security Hardening in README)
DB_USER=sbtest

# Database password — NEVER hardcode in production profiles
# Set via environment variable: export DB_PASSWORD="..."
# Or in a git-excluded .local.env file: DB_PASSWORD="..."
# DB_PASSWORD=

# SSL/TLS for database connection: on | off
# Strongly recommended for production benchmarks against remote hosts
DB_SSL=off

# PostgreSQL SSL mode (when DB_TYPE=pgsql): disable | require | verify-ca | verify-full
DB_PGSQL_SSLMODE=disable

# =============================================================================
# BENCHMARK WORKLOAD PARAMETERS
# =============================================================================

# Number of concurrent worker threads
# Dev/CI: 4-8 | Staging: 16-32 | Production: 32-128+
# Rule of thumb: start at 2x database CPU cores, then tune upward
SB_THREADS=4

# Total benchmark duration in seconds (0 = unlimited/use --events)
# Short validation: 30-60s | Standard benchmark: 300s | Long soak: 3600s+
SB_TIME=60

# How often to print intermediate statistics (seconds, 0 = disabled)
# Recommended: 10 for standard runs, 30 for long soak tests
SB_REPORT_INTERVAL=10

# Number of test tables to create per database
# More tables = less lock contention, more realistic workload
# Dev: 4 | Staging: 10 | Production: 20-50
SB_TABLES=4

# Number of rows per test table
# Dev: 10000 | Staging: 100000 | Production: 1000000+
SB_TABLE_SIZE=10000

# Latency percentile to report in the summary (1-100)
# 95 is standard; use 99 for SLA-sensitive workloads
SB_PERCENTILE=95

# Warmup duration in seconds (statistics excluded from results)
# Recommended: 30-120s to allow buffer pool and caches to warm up
# Set to 0 for cold-start benchmarks
SB_WARMUP_TIME=0

# Random number distribution for key lookups:
#   uniform   - equal probability for all keys (unrealistic but consistent)
#   gaussian  - bell curve distribution
#   special   - hot spots (default sysbench, more realistic)
#   pareto    - power law (very hot spots, models Zipf access patterns)
#   zipfian   - configurable hot-spot distribution
SB_RAND_TYPE=uniform

# Maximum prime for CPU benchmark (higher = longer test)
SB_CPU_MAX_PRIME=10000

# Fileio: total size of files to create (e.g., 10G, 100G)
SB_FILE_TOTAL_SIZE=10G

# Fileio: block size for I/O operations (e.g., 4096, 16384)
SB_FILE_BLOCK_SIZE=16384

# Fileio: test mode (seqrd, seqwr, seqrewr, rndrd, rndwr, rndrw)
SB_FILEIO_MODE=rndrw

# Memory: total data volume to transfer (e.g., 100G)
SB_MEMORY_TOTAL_SIZE=100G

# Memory: block size for memory operations (e.g., 1K, 1M)
SB_MEMORY_BLOCK_SIZE=1K

# Memory: operation type (read | write)
SB_MEMORY_OPERATION=write

# =============================================================================
# SLO THRESHOLDS (Service Level Objectives)
# =============================================================================
# Set to 0 to disable a specific threshold check.
# The benchmark orchestrator exits with code 2 if any enabled threshold is violated.
# CI/CD pipelines should treat exit code 2 as a build failure.

# Minimum acceptable transactions per second (0 = disabled)
# Set based on your application's minimum required throughput
SLO_MIN_TPS=0

# Maximum acceptable p95 latency in milliseconds (0 = disabled)
# Typical values: 10ms (OLTP), 50ms (analytics), 100ms (batch)
SLO_MAX_P95_LATENCY_MS=0

# Maximum acceptable p99 latency in milliseconds (0 = disabled)
# Usually 2-5x the p95 threshold
SLO_MAX_P99_LATENCY_MS=0

# Maximum acceptable error rate as a percentage (0 = disabled)
# Any errors in production benchmarks typically warrant investigation
SLO_MAX_ERROR_RATE_PCT=0

# =============================================================================
# OUTPUT & STORAGE
# =============================================================================

# Directory for storing benchmark results (JSON files)
# Will be created automatically if it does not exist
RESULTS_DIR=./enterprise/results

# Output format: json | csv | text | all
# json: Machine-readable structured result (recommended)
# csv:  Appends a row to a CSV file per workload (for spreadsheet analysis)
# text: Human-readable console output only
# all:  Writes all formats
OUTPUT_FORMAT=json

# Retain raw sysbench output log alongside JSON result: true | false
KEEP_RAW_LOG=false

# Number of days to retain result files before automatic rotation
RESULT_RETENTION_DAYS=90

# =============================================================================
# OBSERVABILITY INTEGRATIONS
# =============================================================================

# Prometheus Pushgateway URL (leave empty to disable metrics push)
# Example: http://pushgateway.monitoring.svc:9091
PROMETHEUS_PUSHGATEWAY=

# Prometheus job name label
PROMETHEUS_JOB=minervadb_sysbench

# =============================================================================
# ALERTING INTEGRATIONS
# =============================================================================

# Slack Incoming Webhook URL for SLO violation alerts (leave empty to disable)
# Example: https://hooks.slack.com/services/T.../B.../...
SLACK_WEBHOOK_URL=

# Slack channel override (leave empty to use webhook's default channel)
# Example: #db-benchmarks
SLACK_CHANNEL=

# PagerDuty Events API v2 routing key for SLO violation incidents
# Leave empty to disable PagerDuty alerting
# Example: a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6
PAGERDUTY_ROUTING_KEY=

# Alert only on SLO violations (true) or also on benchmark success (false)
ALERT_ON_VIOLATIONS_ONLY=true

# =============================================================================
# ADVANCED / EXPERIMENTAL
# =============================================================================

# Number of parallel sysbench instances to spawn (use with caution)
# Useful for simulating multiple application servers. Default: 1
# When > 1, results are aggregated across all instances
SB_PARALLEL_INSTANCES=1

# Custom sysbench extra flags to append (space-separated)
# Example: "--db-ps-mode=disable --skip-trx=on"
SB_EXTRA_FLAGS=

# Path to custom Lua workload script (overrides --workload if set)
# Example: enterprise/workloads/custom_mixed.lua
CUSTOM_WORKLOAD_PATH=

# MySQL-specific: use prepared statements (auto | on | off)
MYSQL_PS_MODE=auto

# PostgreSQL-specific: connection type (socket | tcp)
PGSQL_CONNECTION_TYPE=tcp
