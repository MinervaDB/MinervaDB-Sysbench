# =============================================================================
# MinervaDB-Sysbench Enterprise — Staging Profile
# =============================================================================
# Pre-production validation, CI/CD nightly benchmark runs, and configuration
# change testing before deploying to production.
#
# SECURITY: DB_PASSWORD must be injected via environment variable, never hardcoded.
#   export DB_PASSWORD="$(vault kv get -field=password secret/staging/db)"
#   ./enterprise/scripts/run_benchmark.sh --profile staging
# =============================================================================

# === Database Connection ===
DB_TYPE=mysql
DB_HOST=db-staging.internal
DB_PORT=3306
DB_NAME=sbtest
DB_USER=sbtest_bench
DB_SSL=on

# === Workload Parameters ===
SB_THREADS=16
SB_TIME=120
SB_REPORT_INTERVAL=10
SB_TABLES=10
SB_TABLE_SIZE=100000
SB_PERCENTILE=95
SB_WARMUP_TIME=15
SB_RAND_TYPE=special

# === SLO Thresholds (staging — less strict than production) ===
SLO_MIN_TPS=1000
SLO_MAX_P95_LATENCY_MS=50
SLO_MAX_P99_LATENCY_MS=100
SLO_MAX_ERROR_RATE_PCT=0.5

# === Output ===
RESULTS_DIR=./enterprise/results
OUTPUT_FORMAT=json
KEEP_RAW_LOG=false
RESULT_RETENTION_DAYS=30

# === Integrations (configure via environment or staging.local.env) ===
PROMETHEUS_PUSHGATEWAY=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
ALERT_ON_VIOLATIONS_ONLY=true
